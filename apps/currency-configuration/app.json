{
    "components": {
        "currency-configuration-admin": {
            "type": "component",
            "location": "components"
        },
        "currency-configuration-handler": {
            "type": "service",
            "location": "services"
        }
    },
    "description": {
        "title": "Currency Configuration",
        "author": "Davvag",
        "version": "0.4",
        "icon": "currency-configuration-icon.png"
    },
    "tags": [
        "showindock"
    ],
    "configuration": {
        "webdock": {
            "startupComponent": "currency-configuration-admin",
            "onLoad": [
                "currency-configuration-handler"
            ],
            "routes": {
                "partials": {
                    "/": "currency-configuration-admin"
                }
            }
        }
    },
    "dependencies": {
        "apps": [],
        "schemas": ["currency_configuration"],
        "workflows": [],
        "plugins": [
            "phpcache",
            "sossdata"
        ],
        "php-extensions": []
    }
}
