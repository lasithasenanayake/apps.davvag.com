{
    "components": {
        "product": {
            "type": "service",
            "location": "services"
        },
        "uom-handler": {
            "type": "service",
            "location": "services"
        },
        "product-style": {
            "type": "component",
            "location": "components"
        },
        "frmproduct-list": {
            "type": "component",
            "location": "components"
        },
        "frmproduct-list-popup": {
            "type": "component",
            "location": "components"
        },
        "frmproduct": {
            "type": "component",
            "location": "components"
        },
        "newproduct": {
            "type": "component",
            "location": "components"
        },
        "newproduct_publish": {
            "type": "component",
            "location": "components"
        },
        "newproduct-v2": {
            "type": "component",
            "location": "components"
        },
        "inventory-dashboard": {
            "type": "component",
            "location": "components"
        },
        "document-list": {
            "type": "component",
            "location": "components"
        },
        "document-form": {
            "type": "component",
            "location": "components"
        },
        "document-print": {
            "type": "component",
            "location": "components"
        },
        "uom-manager": {
            "type": "component",
            "location": "components"
        }
    },
    "description": {
        "title": "Products V2",
        "author": "Davvag",
        "version": "0.3",
        "icon": "appicon.png"
    },
    "tags": [
        "showindock"
    ],
    "configuration": {
        "webdock": {
            "startupComponent": "frmproduct-list",
            "onLoad": [
                "product-style",
                "product",
                "uom-handler"
            ],
            "routes": {
                "partials": {
                    "/product": "newproduct-v2",
                    "/publish": "newproduct_publish",
                    "/inventory": "inventory-dashboard",
                    "/po-list": "document-list",
                    "/grn-list": "document-list",
                    "/po": "document-form",
                    "/grn": "document-form",
                    "/po-view": "document-print",
                    "/grn-view": "document-print",
                    "/uom": "uom-manager"
                }
            }
        },
        "dock": {
            "subapps": [
                {
                    "name": "Products",
                    "path": ""
                },
                {
                    "name": "Inventory",
                    "path": "inventory"
                },
                {
                    "name": "Purchase Orders",
                    "path": "po-list"
                },
                {
                    "name": "GRN List",
                    "path": "grn-list"
                },
                {
                    "name": "Unit of Measure",
                    "path": "uom"
                },
                {
                    "name": "New Product",
                    "path": "product"
                }
            ]
        }
    },
    "dependencies": {
        "apps": [
            "davvag-tools"
        ],
        "schemas": [
            "d_all_summery",
            "d_cms_artical_v1",
            "grndetails",
            "grnheader",
            "inventoryhistory",
            "nearproducts",
            "podetails",
            "poheader",
            "product_barcode_units",
            "product_inventryhistory",
            "product_inventrymaster",
            "product_published",
            "profile",
            "products",
            "products_attributes",
            "products_image",
            "uom"
        ],
        "workflows": [],
        "plugins": [
            "auth",
            "davvag-attributes",
            "phpcache",
            "profile",
            "sossdata"
        ],
        "php-extensions": []
    }
}
