{
    "components": {
        "product": {
            "type": "service",
            "location": "services"
        },
        "product-style": {
            "type": "component",
            "location": "components"
        },
        "frmproduct-list": {
            "type": "component",
            "location": "components"
        },
        "frmproduct-list-popup": {
            "type": "component",
            "location": "components"
        },
        "frmproduct": {
            "type": "component",
            "location": "components"
        },
        "newproduct": {
            "type": "component",
            "location": "components"
        },
        "newproduct_publish": {
            "type": "component",
            "location": "components"
        },
        "newproduct-v2": {
            "type": "component",
            "location": "components"
        }
    },
    "description": {
        "title": "Products V2",
        "author": "Davvag",
        "version": "0.3",
        "icon": "appicon.png"
    },
    "tags": [
        "showindock"
    ],
    "configuration": {
        "webdock": {
            "startupComponent": "frmproduct-list",
            "onLoad": [
                "product-style",
                "product"
            ],
            "routes": {
                "partials": {
                    "/product": "newproduct-v2",
                    "/publish": "newproduct_publish"
                }
            }
        }
    },
    "dependencies": {
        "apps": [
            "davvag-tools"
        ],
        "schemas": [
            "d_all_summery",
            "d_cms_artical_v1",
            "nearproducts",
            "product_published",
            "products",
            "products_attributes",
            "products_image"
        ],
        "workflows": [],
        "plugins": [
            "auth",
            "davvag-attributes",
            "phpcache",
            "profile",
            "sossdata"
        ],
        "php-extensions": []
    }
}
