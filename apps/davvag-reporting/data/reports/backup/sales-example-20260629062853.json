    "description": "",
    "namespace": "rpt_sales_example",
    "sql": "SELECT \n    oh.name,\n    oh.address,\n    oh.total\nFROM orderheader oh\nINNER JOIN profile p \n    ON p.id = oh.profileId\nWHERE oh.PaymentComplete = 'Y'\n  AND oh.invoiceDate BETWEEN '$startDate' AND '$endDate'",
