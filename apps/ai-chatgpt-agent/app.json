{
    "components": {
        "chat-console": {
            "type": "component",
            "location": "components"
        },
        "agent-api": {
            "type": "service",
            "location": "services"
        }
    },
    "description": {
        "title": "AI ChatGPT Agent",
        "author": "Davvag",
        "version": "0.2",
        "icon": ""
    },
    "tags": [
        "showindock"
    ],
    "configuration": {
        "webdock": {
            "startupComponent": "chat-console",
            "onLoad": [
                "agent-api"
            ],
            "routes": {
                "partials": {
                    "/": "chat-console"
                }
            }
        }
    },
    "dependencies": {
        "apps": [
            "davvag-tools"
        ],
        "schemas": [
            "profile"
        ],
        "workflows": [],
        "plugins": [
            "auth",
            "phpcache",
            "sossdata"
        ],
        "php-extensions": [
            "curl"
        ]
    }
}
