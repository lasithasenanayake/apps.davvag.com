{
  "name": "public",
  "version": "1.1.1",
  "resources": {
    "files": [
      {
        "type": "mainScript",
        "location": "script.js"
      }
    ]
  },
  "serviceHandler": {
    "file": "service.php",
    "class": "davvag_events\\PublicService",
    "serviceNamespaces": [
      "davvag_events_events",
      "davvag_events_commit",
      "davvag_events_rate"
    ],
    "methods": {
      "Exchange": {
        "method": "POST"
      },
      "Invitation": {
        "method": "GET",
        "parameters": [
          "eventId",
          "offset",
          "name"
        ]
      },
      "Unlock": {
        "method": "POST"
      },
      "Respond": {
        "method": "POST"
      },
      "Seat": {
        "method": "GET",
        "parameters": [
          "eventId",
          "offset",
          "name"
        ]
      },
      "Calendar": {
        "method": "GET",
        "parameters": [
          "eventId",
          "offset",
          "name"
        ]
      }
    }
  },
  "transformers": {}
}
