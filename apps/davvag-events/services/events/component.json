{
  "name": "events",
  "version": "1.1.1",
  "resources": {
    "files": [
      {
        "type": "mainScript",
        "location": "script.js"
      }
    ]
  },
  "serviceHandler": {
    "file": "service.php",
    "class": "davvag_events\\EventService",
    "serviceNamespaces": [
      "davvag_events_events",
      "davvag_events_commit",
      "davvag_events_drive_connections"
    ],
    "methods": {
      "Session": {
        "method": "GET",
        "parameters": [
          "eventId",
          "offset",
          "name"
        ]
      },
      "ListEvents": {
        "method": "GET",
        "parameters": [
          "eventId",
          "offset",
          "name"
        ]
      },
      "Event": {
        "method": "GET",
        "parameters": [
          "eventId",
          "offset",
          "name"
        ]
      },
      "SaveEvent": {
        "method": "POST"
      },
      "Transition": {
        "method": "POST"
      },
      "Member": {
        "method": "POST"
      },
      "Preview": {
        "method": "GET",
        "parameters": [
          "eventId",
          "offset",
          "name"
        ]
      },
      "Report": {
        "method": "GET",
        "parameters": [
          "eventId",
          "offset",
          "name"
        ]
      },
      "RetryJob": {
        "method": "POST"
      },
      "DeleteEvent": {
        "method": "POST"
      },
      "SaveTemplate": {
        "method": "POST"
      }
    }
  },
  "transformers": {}
}
