  "description": {
    "title": "DAVVAG Events",
    "author": "DAVVAG",
    "version": "1.1.1",
    "icon": "appicon.svg"
  },
  "tags": [
    "showincms",
    "showindock"
  ],
  "configuration": {
    "webdock": {
      "startupComponent": "dashboard-view",
      "onLoad": [
        "event-style",
        "events",
        "guests",
        "public",
        "seating",
        "greetings",
        "media",
        "oauth",
        "sales",
        "webhook",
        "checkin"
      ],
      "routes": {
        "partials": {
          "/": "dashboard-view",
          "/dashboard": "dashboard-view",
          "/editor": "editor-view",
          "/guests": "guests-view",
          "/seating": "seating-view",
          "/greetings": "greetings-view",
          "/media": "media-view",
          "/ticketing": "ticketing-view",
          "/checkin": "checkin-view",
          "/reports": "reports-view",
          "/settings": "settings-view",
          "/invitation": "invitation-view",
          "/wall": "wall-view",
          "/upload": "upload-view",
          "/tickets": "tickets-view"
        }
      }
    },
    "dock": {
      "subapps": [
        {
          "name": "Dashboard",
          "path": "dashboard"
        },
        {
          "name": "Editor",
          "path": "editor"
        },
        {
          "name": "Guests",
          "path": "guests"
        },
        {
          "name": "Seating",
          "path": "seating"
        },
        {
          "name": "Checkin",
          "path": "checkin"
        },
        {
          "name": "Reports",
          "path": "reports"
        }
      ]
    }
  },
  "dependencies": {
    "apps": [
      "davvag-cms-v7"
    ],
    "schemas": [
      "profile",
      "usergroup_permission",
      "davvag_events_events",
      "davvag_events_keys",
      "davvag_events_drive_connections",
      "davvag_events_limits",
      "davvag_events_commit",
      "davvag_events_connection_commit",
      "davvag_events_rate"
    ],
    "workflows": [],
    "plugins": {
      "local": [],
      "global": [
        "auth",
        "sossdata",
        "phpcache",
        "notify"
      ]
    },
    "php-extensions": [
      "mysqli",
      "mysqlnd",
      "curl",
      "openssl",
      "fileinfo",
      "mbstring",
      "json",
      "session",
      "dom"
    ]
  }
}
