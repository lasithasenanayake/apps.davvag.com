    "credit-ledger-api": {"type":"service","location":"services"},
    "credit-admin-api": {"type":"service","location":"services"},
    "credit-payment-api": {"type":"service","location":"services"}
  },
  "description": {"title":"Credit Points","author":"DAVVAG","version":"1.4","icon":"appicon.svg"},
  "tags": ["showincms","showindock"],
  "configuration": {
    "webdock": {
      "startupComponent":"wallet-home",
      "onLoad":["credit-style","credit-api","credit-admin-api","credit-payment-api"],
      "routes":{"partials":{
        "/":"wallet-home","/buy":"package-store","/rewards":"reward-centre","/redeem":"coupon-redeem","/history":"transaction-history","/purchase-status":"purchase-status","/admin":"admin-console","/admin/packages":"package-admin","/admin/rewards":"reward-admin","/admin/coupons":"coupon-admin"
      }}
    },
    "dock":{"subapps":[
      {"name":"Wallet","path":""},{"name":"Buy credits","path":"buy"},{"name":"Rewards","path":"rewards"},{"name":"Redeem coupon","path":"redeem"},{"name":"History","path":"history"},{"name":"Administration","path":"admin"}
    ]}
  },
  "dependencies": {
    "apps":["davvag-paypal","lesson-manager","davvag-scheduler","currency-configuration","productapp"],
    "schemas":["currency_configuration","davvag_credit_program","davvag_credit_wallet","davvag_credit_transaction","davvag_credit_entry","davvag_credit_lot","davvag_credit_reservation","davvag_credit_package","davvag_credit_purchase_order","davvag_credit_payment_event","davvag_credit_reward_rule","davvag_credit_reward_claim","davvag_credit_coupon_campaign","davvag_credit_coupon_code","davvag_credit_coupon_redemption","davvag_credit_idempotency","davvag_credit_lesson_unlock","profile","lesson_manager_lesson","products"],
    "workflows":[],
    "plugins":["auth","sossdata","profile","notify"],
    "php-extensions":["mysqli","openssl","curl"]
  }
}
