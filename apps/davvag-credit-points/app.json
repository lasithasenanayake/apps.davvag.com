    "package-store": {"type":"component","location":"components"},
    "reward-centre": {"type":"component","location":"components"},
    "coupon-redeem": {"type":"component","location":"components"},
    "transaction-history": {"type":"component","location":"components"},
    "purchase-status": {"type":"component","location":"components"},
    "credit-balance-badge": {"type":"component","location":"components"},
    "admin-console": {"type":"component","location":"components"},
    "package-admin": {"type":"component","location":"components"},
    "reward-admin": {"type":"component","location":"components"},
    "coupon-admin": {"type":"component","location":"components"},
    "credit-style": {"type":"component","location":"components"},
