    "configuration": {
        "webdock": {
            "startupComponent": "dock-shell",
            "onLoad": [
                "cms-v7-api",
                "app_popup",
                "soss-routes",
                "attribute_shell",
                "attribute_shell_popup",
                "soss-uploader",
                "soss-validator",
                "auth-handler",
                "soss-data",
                "soss-routes-vue",
                "nav-bar",
                "footer-bar"
            ],
            "routes": {
                "home": "/",
                "notFound": "/not-found",
                "partials": {
                    "/": "home",
                    "/home": "home",
                    "/lifelesson": "lifelesson",
                    "/wallclimbingbeginner2026": "wallclimbingbeginner2026",
                    "/app/@appName/*appRoute": "partial-app",
                    "/not-found": "partial-404",
                    "/notFound": "partial-404"
                }
            }
        },
        "cmsv7": {
            "startup": {
                "mode": "page",
                "route": "/"
            }
        }
    },
    "dependencies": {
        "apps": [
