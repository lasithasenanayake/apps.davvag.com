{
    "components": {
        "profile-catogory-admin": {
            "type": "component",
            "location": "components"
        },
        "profile-catogory-handler": {
            "type": "service",
            "location": "services"
        }
    },
    "description": {
        "title": "Profile Catogories",
        "author": "Davvag",
        "version": "0.1",
        "icon": "profile-catogory-creator-icon.png"
    },
    "tags": [
        "showindock"
    ],
    "configuration": {
