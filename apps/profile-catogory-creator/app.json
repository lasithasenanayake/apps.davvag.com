                    "/": "profile-catogory-admin"
                }
            }
        }
    },
    "dependencies": {
        "apps": [],
        "schemas": [],
        "workflows": [],
        "plugins": [
            "phpcache",
            "sossdata"
        ],
        "php-extensions": []
    }
}
