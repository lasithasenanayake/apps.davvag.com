        "author": "Daavg",
        "version": "0.71",
        "icon": "davvag-cms-icon.png"
    },
    "configuration": {
        "webdock": {
            "startupComponent": "product",
            "onLoad": [
                "dependencies",
                "app_popup",
                "soss-routes",
                "attribute_shell",
                "attribute_shell_popup",
                "soss-routes-vue",
                "soss-uploader",
                "soss-validator",
                "auth-handler",
                "soss-data"
            ],
            "firewall": {
                "guest": [],
                "admin": []
            },
            "routes": {
                "home": "/home",
                "notFound": "/notFound",
                "partials": {
                    "/": "partial-homeblog-bg",
                    "/app/@appName/*appRoute": "partial-app",
                    "/p/@username": "partial-user",
                    "/home": "partial-homeblog",
                    "/donate": "partial-donation",
                    "/notFound": "partial-404",
                    "/account": "partial-account",
                    "/profile": "partial-profile",
                    "/help": "partial-help"
                }
            }
        }
    },
    "dependencies": {
        "apps": [
            "currency-configuration",
            "davvag-tools"
        ],
        "schemas": [
            "currency_configuration",
            "davvag_launchers_query",
            "davvag_launchers_subquery",
            "profile_notify_u"
        ],
        "workflows": [],
        "plugins": [
            "auth",
            "davvag-attributes",
            "phpcache",
            "profile",
