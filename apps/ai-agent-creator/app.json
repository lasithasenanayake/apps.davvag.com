{
    "components": {
        "creator-console": {
            "type": "component",
            "location": "components"
        },
        "creator-api": {
            "type": "service",
            "location": "services"
        }
    },
    "description": {
        "title": "AI Agent Creator",
        "author": "Davvag",
        "version": "0.4",
        "icon": "ai-agent-creator-icon.png"
    },
    "tags": [
        "showindock"
    ],
    "configuration": {
        "webdock": {
            "startupComponent": "creator-console",
            "onLoad": [
                "creator-api"
            ],
            "routes": {
                "partials": {
                    "/": "creator-console"
                }
            }
        }
    },
    "dependencies": {
        "apps": [
            "davvag-tools"
        ],
        "schemas": [
            "profile",
            "users",
            "usergroups",
            "domain_permision",
            "ai_agent_billing_usage",
            "ai_agent_error_log"
        ],
        "workflows": [],
        "plugins": [
            "auth",
            "phpcache",
            "sossdata"
        ],
        "php-extensions": [
            "curl"
        ]
    }
}
