{
    "name": "AI Agent Creator API",
    "description": "Validates AI provider settings and generates structured agent configuration objects.",
    "author": "Davvag",
    "version": "0.5.0",
    "gitUrl": "",
    "resources": {
        "files": [
            {
                "type": "mainScript",
                "location": "script.js"
            }
        ]
    },
    "serviceHandler": {
        "file": "service.php",
        "class": "ai_agent_creator\\CreatorService",
        "methods": {
            "GenerateConfig": {
                "method": "POST"
            },
            "SaveAgent": {
                "method": "POST"
            },
            "ListAgents": {
                "method": "GET"
            },
            "DeleteAgent": {
                "method": "POST"
            },
            "TestAgent": {
                "method": "POST"
            },
            "RunAgent": {
                "method": "POST"
            },
            "InteractWithAgent": {
                "method": "POST"
            },
            "ClearSession": {
                "method": "POST"
            },
            "Providers": {
                "method": "GET"
            },
            "DiscoverModels": {
                "method": "POST"
            }
        }
    },
    "transformers": {}
}
