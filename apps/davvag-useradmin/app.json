{
    "components": {
        "user-handler": {
            "type": "service",
            "location": "services"
        },
        "users": {
            "type": "component",
            "location": "app"
        },
        "groups": {
            "type": "component",
            "location": "app"
        }
    },
    "description": {
        "title": "Users",
        "author": "Lasitha Senanayake",
        "version": "0.1",
        "icon": "appicon.png"
    },
    "tags": [
        "showindock"
    ],
    "configuration": {
        "webdock": {
            "startupComponent": "users",
            "onLoad": [
                "user-handler",
                "showincms"
            ],
            "routes": {
                "partials": {
                    "/keyword": "users",
                    "/users": "users",
                    "/groups": "groups"
                }
            }
        },
        "dock": {
            "subapps": [
                {
                    "name": "Users",
                    "path": "keyword"
                },
                {
                    "name": "User Groups",
                    "path": "groups"
                }
            ]
        }
    },
    "resources": {
        "js": [
            {
                "tag": "bootstrap-datetimepicker",
                "version": "latest",
                "location": "assets/bootstrap-datetimepicker.min.js"
            }
        ],
        "css": [
            {
                "type": "css",
                "location": "assets/bootstrap-datetimepicker.min.css"
            },
            {
                "type": "css",
                "location": "assets/broadstyle.css"
            }
        ]
    },
    "dependencies": {
        "apps": [],
        "schemas": [

            "profile",
            "schedule_pending",
            "users",
            "usergroups",
            "domain_permision"
        ],
        "workflows": [],
        "plugins": [
            "auth",
            "phpcache",
            "sossdata"
        ],
        "php-extensions": []
    }
}
