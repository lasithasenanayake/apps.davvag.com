{
    "components": {
        "projects": {
            "type": "component",
            "location": "components"
        },
        "tasks": {
            "type": "component",
            "location": "components"
        },
        "my-tasks": {
            "type": "component",
            "location": "components"
        },
        "time-tracker": {
            "type": "component",
            "location": "components"
        },
        "password-vault": {
            "type": "component",
            "location": "components"
        },
        "task-view": {
            "type": "component",
            "location": "components"
        },
        "task-dashboard": {
            "type": "component",
            "location": "components"
        },
        "task-style": {
            "type": "component",
            "location": "components"
        },
        "taskapi": {
            "type": "service",
            "location": "services"
        },
        "passwordvaultapi": {
            "type": "service",
            "location": "services"
        },
        "TaskEmailClient": {
            "type": "service",
            "location": "services"
        }
    },
    "description": {
        "title": "Task Manager",
        "author": "DAVVAG",
        "version": "2.1",
        "icon": "appicon.png"
    },
    "tags": [
        "showincms",
        "showindock"
    ],
    "configuration": {
        "webdock": {
            "startupComponent": "projects",
            "onLoad": [
                "task-style",
                "taskapi",
                "passwordvaultapi"
            ],
            "routes": {
                "partials": {
                    "/": "projects",
                    "/projects": "projects",
                    "/tasks": "tasks",
                    "/my-tasks": "my-tasks",
                    "/time-tracker": "time-tracker",
                    "/password-vault": "password-vault",
                    "/task": "task-view",
                    "/task-view": "task-view"
                }
            }
        },
        "dock": {
            "subapps": [
                {
                    "name": "Projects",
                    "path": "projects"
                },
                {
                    "name": "My Tasks",
                    "path": "my-tasks"
                },
                {
                    "name": "Time Tracker",
                    "path": "time-tracker"
                }
            ]
        }
    },
    "dependencies": {
        "apps": [
            "davvag-tools"
        ],
        "schemas": [
            "profile"
        ],
        "workflows": [],
        "plugins": [
            "auth",
            "phpcache",
            "profile",
            "sossdata"
        ],
        "php-extensions": [
            "imap"
        ]
    }
}
