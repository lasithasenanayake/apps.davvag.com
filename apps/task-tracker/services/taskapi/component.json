{
    "name": "taskapi",
    "description": "Task Manager service handlers",
    "author": "DAVVAG",
    "version": "0.4",
    "resources": {
        "files": [
            {
                "type": "mainScript",
                "location": "script.js"
            }
        ]
    },
    "serviceHandler": {
