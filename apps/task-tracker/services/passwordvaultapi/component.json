{
    "name": "passwordvaultapi",
    "description": "Task Manager password vault service handlers",
    "author": "DAVVAG",
    "version": "0.1",
    "resources": {
        "files": [
            {
                "type": "mainScript",
                "location": "script.js"
            }
        ]
    },
    "serviceHandler": {
        "file": "service.php",
        "class": "PasswordVaultService",
