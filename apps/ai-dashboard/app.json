{
    "components": {
        "dashboard-view": {
            "type": "component",
            "location": "components"
        },
        "dashboard-api": {
            "type": "service",
            "location": "services"
        }
    },
    "description": {
        "title": "AI Dashboard",
        "author": "Davvag",
        "version": "0.1",
        "icon": ""
    },
    "tags": [
        "showindock"
    ],
    "configuration": {
        "webdock": {
            "startupComponent": "dashboard-view",
            "onLoad": [
                "dashboard-api"
            ],
            "routes": {
                "partials": {
                    "/": "dashboard-view"
                }
            }
        }
    },
    "dependencies": {
        "apps": [
            "ai-agent-creator"
        ],
        "schemas": [
            "ai_agent_billing_usage",
            "ai_agent_error_log",
            "ai_agent_billing_usage_daily_report",
            "ai_agent_billing_usage_weekly_report",
            "ai_agent_billing_usage_monthly_report"
        ],
        "workflows": [],
        "plugins": [
            "sossdata"
        ],
        "php-extensions": []
    }
}
